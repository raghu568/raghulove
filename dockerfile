FROM docker.dxc.com/eprocurement-docker/adoptopenjdk/openjdk15:jdk-15.0.2_7-alpine
COPY indent-service.jar /deployments/indent-service.jar
EXPOSE 8080
CMD java -Dspring.profiles.active=$PROFILE -Duser.timezone="Asia/Kolkata" -XX:+UnlockDiagnosticVMOptions -XX:+ExpandSubTypeCheckAtParseTime -jar /deployments/indent-service.jar --DB_HOSTNAME=$DATABASE_SVC --DB_PORT=$DATABASE_PORT --DB_DATABASE=$DATABASE_NAME --DB_USER=$DATABASE_USER --DB_PASSWORD=$DATABASE_PASSWORD --PKI_DB_HOSTNAME=$PKI_DATABASE_SVC --PKI_DB_PORT=$PKI_DATABASE_PORT --PKI_DB_DATABASE=$PKI_DATABASE_NAME --PKI_DB_USER=$PKI_DATABASE_USER --PKI_DB_PASSWORD=$PKI_DATABASE_PASSWORD --KIE_SERVER_URL=$KIE_SERVER_URL --INDENT_SERVER_URL=$INDENT_SERVER_URL --userService.url=$USER_SERVICE --opentracing.jaeger.enabled=$JAEGER_ENABLED  --opentracing.jaeger.http-sender.url=$JAEGER_URI/api/traces --spring.security.oauth2.resourceserver.jwt.issuer-uri=$ISSUER_URI --spring.security.oauth2.resourceserver.jwt.jwk-set-uri=$JWK_SET_URI --S3_ACCESS_KEY=$S3_ACCESS_KEY --S3_SECRET_KEY=$S3_SECRET_KEY --S3_REGION_NAME=$S3_REGION_NAME --S3_URL=$S3_URL
